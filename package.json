{
    "name": "mcp-docsrs",
    "version": "1.0.0",
    "description": "MCP server for fetching Rust crate documentation via docs.rs JSON API",
    "type": "module",
    "main": "./dist/mcp-docsrs",
    "bin": {
        "mcp-docsrs": "./dist/cli.js"
    },
    "scripts": {
        "start": "./dist/mcp-docsrs",
        "dev": "tsx src/cli.ts",
        "build": "tsc",
        "postbuild": "chmod +x dist/cli.js",
        "prebuild": "rm -rf dist",
        "typecheck": "tsc --noEmit",
        "inspector": "DANGEROUSLY_OMIT_AUTH=true npx @modelcontextprotocol/inspector -- node ./dist/cli.js --cache-ttl=7200000 --max-cache-size=200 --db-path=./.cache",
        "lint": "biome check ./src && biome check ./test",
        "lint:fix": "biome check ./src --fix && biome check ./test --fix",
        "lint:fixunsafe": "biome check ./src --fix --unsafe && biome check ./test --fix --unsafe",
        "test": "NODE_ENV=test vitest run test/unit",
        "test:unit": "NODE_ENV=test vitest run test/unit",
        "test:integration": "NODE_ENV=test vitest run test/integration/api test/integration/persistence test/integration/e2e",
        "test:integration:api": "NODE_ENV=test vitest run test/integration/api",
        "test:integration:binary": "NODE_ENV=test vitest run test/integration/binary/runner.test.ts",
        "test:all": "npm run test:unit && npm run test:integration",
        "test:watch": "NODE_ENV=test vitest test/unit",
        "check:sizes": "tsx scripts/check-build-sizes.ts"
    },
    "keywords": [
        "mcp",
        "rust",
        "docs",
        "documentation",
        "nodejs"
    ],
    "author": "Marius Modlich <marius@junonetwork.io>",
    "license": "Apache-2.0",
    "dependencies": {
        "@modelcontextprotocol/sdk": "1.13.0",
        "better-sqlite3": "^9.0.0",
        "fzstd": "0.1.1",
        "zod": "3.25.67"
    },
    "devDependencies": {
        "@biomejs/biome": "2.0.0",
        "@types/node": "^20.0.0",
        "tsx": "^4.0.0",
        "vitest": "^1.0.0",
        "typescript": "5.8.3"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
